{
  "name": "vault-dweller",
  "version": "0.0.1",
  "description": "Obsidian vault agent for creating and managing an AI-assisted knowledge base and second brain",
  "license": "MIT",
  "author": "Cenron",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "vault-dweller",
    "obsidian",
    "knowledge base",
    "second brain"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./resources/skills"
    ],
    "prompts": [
      "./resources/prompts/*.md"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "check": "npm run typecheck && npm run lint && npm run test:cov"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
